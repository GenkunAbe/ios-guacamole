diff --git a/pexpert/pexpert/arm64/sweet_dev.h b/pexpert/pexpert/arm64/sweet_dev.h
index 0b7870b..f588e29 100644
--- a/pexpert/pexpert/arm64/sweet_dev.h
+++ b/pexpert/pexpert/arm64/sweet_dev.h
@@ -119,7 +119,89 @@
 #define SWEET_DEV_PANEL_MM_W    76
 #define SWEET_DEV_PANEL_MM_H    163
 
-#else /* !ARM64_BOARD_CONFIG_GUACAMOLE -> sweet */
+#elif defined(ARM64_BOARD_CONFIG_M1973)
+
+/* ------------- Meizu 16s Pro (m1973, SM8150 / SD855+) ------------- */
+
+#define SWEET_DEV_NAME          "m1973"
+
+/* ABL continuous-splash framebuffer: stock-DTS reserved-memory
+ * cont_splash_region@9c000000 + 0x2400000 (36 MiB), exact. Panel: Samsung
+ * SOFEF00M AMOLED, 1080x2232 (FHD+), DSI cmd mode, 4 lanes (stock dtbo
+ * dsi_sofef00m_amoled_cmd: hfp/hbp 66/66, hsync 20, vfp/vbp 8/12). */
+#define SWEET_DEV_FB_PA         0x9c000000UL
+#define SWEET_DEV_FB_W          1080
+#define SWEET_DEV_FB_H          2232
+#define SWEET_DEV_FB_STRIDE     (SWEET_DEV_FB_W * 4)
+
+/* SPMI arbiter v5 at 0xc440000 (stock DTS qcom,spmi@c440000, same reg
+ * layout as guacamole). PMIC SIDs: PM8150 = 0 (PON, keys, pinctrl@c000),
+ * PM8150B = 2 (charger), PM8150L = 4; no PM8009 on this board. */
+#define SWEET_DEV_SPMI_CORE_PA  0x0c440000u
+#define SWEET_DEV_SPMI_OBS_PA   0x0e600000u
+#define SWEET_DEV_SPMI_CFG_PA   0x0c40a000u
+#define SWEET_DEV_PON_RT        0x0810u
+
+/* Keys: stock dtbo gpio_keys puts volume-up on PM8150 (SID 0) GPIO6,
+ * active-low, same pin as guacamole; volume-down is PON RESIN (the dtbo
+ * pon node exposes the "resin" interrupt), like the sweet board. */
+#define SWEET_DEV_KEYS_VOLUME   1
+#define SWEET_DEV_VOL_GPIO_RT   0xc510u         /* volume up: PM8150 GPIO6 */
+#define SWEET_DEV_VOL_GPIO_SID  0               /* PM8150 */
+#define SWEET_DEV_VOL_DOWN_PON  1               /* volume-down is PON RESIN */
+
+/* RPMh: apps RSC at 0x18220000, TCS at 0x18220d00, command DB at
+ * 0xc3f0000c (stock DTS qcom,cmd-db@c3f000c) - same as guacamole. */
+#define SWEET_DEV_RPMH_RSC_PA   0x18220000u
+#define SWEET_DEV_RPMH_TCS_PA   0x18220d00u
+#define SWEET_DEV_RPMH_TCS_SIZE 0x3000u
+#define SWEET_DEV_RPMH_DICT_PA  0x0c3f000cu
+
+/* Touch: Goodix GT9886 @0x5d on qupv3 SE17 I2C (i2c@0xc80000, same SE as
+ * guacamole's touch), IRQ tlmm 122, vtouch pm8150_l17 ("ldoa17"). The
+ * Samsung transport does not apply; no Goodix transport yet. */
+#define SWEET_DEV_TOUCH         0
+#define SWEET_DEV_TOUCH_SEC     0
+#define SWEET_DEV_TOUCH_VREG_NAME "ldoa17"
+#define SWEET_DEV_TOUCH_VREG_MV 3008
+#define SWEET_DEV_TOUCH_SE_PA   0x00c80000u
+#define SWEET_DEV_TOUCH_GCC_PA  0x00100000u
+#define SWEET_DEV_TOUCH_NORTH_PA 0x03000000u   /* stock DTS pinctrl@03000000 */
+#define SWEET_DEV_TOUCH_GCC_VOTE 0x52014u      /* VERIFY: qupv3 wrap2 CBCR */
+#define SWEET_DEV_TOUCH_RCG     0x1e148u       /* VERIFY: qupv3 wrap2 s0 src */
+
+/* Reset-surviving scratch for the USB gadget progress marker. VERIFY:
+ * assumes the SM8150 upper bank at 0x180000000 as on guacamole; the
+ * shim probe report prints /memory before anything reads this. */
+#define SWEET_DEV_MARK_PA       0x198000000UL
+
+/* SM8150 DWC3 quirks, same as guacamole. */
+#define SWEET_DEV_USB_ARM_ON_EVENT 1
+#define SWEET_DEV_USB_VBUS_DEFAULT 3
+
+/* USB: usb0 = ssusb@a600000 + dwc3@a600000 + hsphy@88e2000 +
+ * ssphy@88e8000, same SoC wiring as guacamole (stock DTS). GCC offsets
+ * from mainline gcc-sm8150.c. */
+#define SWEET_DEV_USB           1
+#define SWEET_DEV_USB_GCC_PA    0x00100000u
+#define SWEET_DEV_USB_DWC3_PA   0x0a600000u
+#define SWEET_DEV_USB_QUSB2_PA  0x088e2000u
+#define SWEET_DEV_USB_QSCRATCH_PA 0x0a6f8800u
+#define SWEET_DEV_USB_GDSCR     0x0f004u
+#define SWEET_DEV_USB_CBCR_MASTER 0x0f010u
+#define SWEET_DEV_USB_CBCR_SLEEP  0x0f014u
+#define SWEET_DEV_USB_CBCR_UTMI   0x0f018u
+#define SWEET_DEV_USB_CBCR_CFGNOC 0x0f078u
